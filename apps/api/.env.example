# API Configuration
PORT=4000
NODE_ENV=development

# Generate with: openssl rand -base64 32
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars

# PostgreSQL — local Docker (see docker-compose.yml) or managed service
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/messenger?schema=public"

# Redis — local Docker or managed service (Upstash, Redis Cloud, etc.)
REDIS_URL="redis://localhost:6379"

# Metrics endpoint bearer token (leave unset to disable /metrics entirely)
# Generate with: openssl rand -base64 24
METRICS_TOKEN=

# S3 Storage (optional — leave S3_ENABLED=false to use local disk)
S3_ENABLED=false
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
